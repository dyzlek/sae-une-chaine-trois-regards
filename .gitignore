# Secrets : jamais dans Git
.env
.env.*
*.key
*auth-key*
secrets/

# Outils locaux de l'assistant (on partage seulement les hooks et settings.json)
.claude/*
!.claude/settings.json
!.claude/hooks/
.claude/settings.local.json

# Dépendances et builds
node_modules/
dist/
build/
__pycache__/
*.pyc
.venv/

# Base de données locale (chaque nœud a la sienne)
*.db
*.sqlite
*.sqlite3
data/

# OS / éditeurs
.DS_Store
Thumbs.db
.vscode/
.idea/

# Exports PDF de test (le rendu final se dépose sur Moodle)
rendus/

